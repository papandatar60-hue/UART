library IEEE;
use IEEE.STD_LOGIC_1164.ALL;
use IEEE.STD_LOGIC_UNSIGNED.ALL;

entity counter is
    Port (
        CLK : in STD_LOGIC;
        Q : out STD_LOGIC_VECTOR(3 downto 0)
    );
end counter;

architecture Behavioral of counter is

signal temp : STD_LOGIC_VECTOR(3 downto 0) := "0000";

begin

process(CLK)
begin
    if rising_edge(CLK) then
        temp <= temp + 1;
    end if;
end process;

Q <= temp;

end Behavioral;

