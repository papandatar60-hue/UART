entity tb_counter is
end tb_counter;

architecture behavior of tb_counter is

component counter
    Port (
        CLK : in STD_LOGIC;
        Q : out STD_LOGIC_VECTOR(3 downto 0)
    );
end component;

signal CLK : STD_LOGIC := '0';
signal Q : STD_LOGIC_VECTOR(3 downto 0);

begin

UUT: counter port map(
    CLK => CLK,
    Q => Q
);

clock_process: process
begin
    CLK <= '0';
    wait for 50 ns;
    CLK <= '1';
    wait for 50 ns;
end process;

end behavior;
